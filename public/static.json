{
  "redirects": [
    {
      "source": "/api/:splat",
      "destination": "https://fam-backend.onrender.com/api/:splat",
      "type": "proxy"
    }
  ],
  "rewrites": [
    { "source": "/pages/:page", "destination": "/pages/:page.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
