# ═══════════════════════════════════════════════════════════════
#  Flamingo aur Maina — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Frontend (Vite) ──────────────────────────────────────────────
# Backend API base URL (used by the React app in src/)
# Defaults to "/api/v1" (same-origin via Netlify proxy).
# Set to your local or deployed backend URL.
VITE_API_URL=/api/v1

# ── Backend (Express) ──────────────────────────────────────────
# See backend/.env.example for a full list of backend variables.
# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fam?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay (payments)
# TEST keys start with rzp_test_; LIVE keys start with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret (Razorpay Dashboard → Settings → Webhooks). Used to verify
# signatures on /api/v1/payments/webhook events.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Minutes an unpaid pending booking stays reserved before the expiry job
# releases its inventory. Default 1440 (24h).
PENDING_BOOKING_TTL_MINUTES=1440

# SMTP / Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Flamingo aur Maina <noreply@flamingoaurmaina.com>

# Frontend URL (for CORS, email links, redirects)
FRONTEND_URL=http://localhost:5173

# OAuth (Google & Apple Sign-In)
# APP_URL = public base URL of the backend (used to build OAuth callback URLs)
APP_URL=http://localhost:5000
# Used to sign the OAuth state cookie (use a long random string)
SESSION_SECRET=your-session-secret-change-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
