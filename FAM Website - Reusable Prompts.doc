.prompt { background-color: #f8f4ec; border: 1pt solid #C9A86A; border-left: 4pt solid #C9A86A; padding: 10pt 12pt; font-family: Consolas, 'Courier New', monospace; font-size: 10pt; line-height: 145%; }
.tip { background-color: #eef4ee; border-left: 4pt solid #234b32; padding: 8pt 12pt; font-size: 10pt; }
