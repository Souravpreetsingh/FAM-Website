h1 { font-family: Georgia, 'Playfair Display', serif; font-size: 26pt; color: #0a341d; margin-bottom: 6pt; }
h2 { font-family: Georgia, serif; font-size: 16pt; color: #0a341d; border-bottom: 2px solid #C9A86A; padding-bottom: 4pt; margin-top: 28pt; }
